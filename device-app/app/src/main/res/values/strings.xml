    <string name="payload_init_title">Init relay</string>
    <string name="payload_init_meta">payload.bin · init domain</string>
    <string name="payload_init_body">Patches libbase ~LogMessage. The relay activates on the next init LOG after you trigger it from ADB.</string>
    <string name="payload_bt_title">Bluetooth read relay</string>
    <string name="payload_bt_meta">payload_bt_read.bin · bluetooth domain</string>
    <string name="payload_bt_body">Patches the gatt_act_read entry in libbluetooth_jni.so. Code execution needs a live GATT read; this runner performs no Bluetooth I/O.</string>
