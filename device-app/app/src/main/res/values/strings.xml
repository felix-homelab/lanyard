    <!-- Consent -->
    <string name="consent_title">Execute %1$s?</string>
    <string name="consent_intro">This writes a kernel page-cache patch on the verified lab device. It is not a general-purpose root tool and it is not reversible without a reboot.</string>
    <string name="consent_row_payload">Payload</string>
    <string name="consent_row_entry">Entry</string>
